# Dependencies and build output
node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

# Environment files — never commit real values
.env
.env.*
!.env.example

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test output
junit*.xml
playwright-report/
test-results/
blob-report/
.playwright/

# Adjuntos (ADR-021): binarios de usuarios, nunca en Git. Rutas ancladas: un patrón
# suelto `storage/` ignoraría también backend/src/infrastructure/storage/.
/storage/
/backend/storage/

# Local database artefacts
backend/prisma/*.db
backend/prisma/*.db-journal

# Keys and secrets
*.pem
*.key
*.pfx
*.p12
secrets/

# Cache de Python (scripts de skills de terceros)
__pycache__/
*.pyc

# Informes de la carga inicial por scripts (solo filas y motivos, pero son artefactos de cada ejecucion)
informe-carga-*.csv
