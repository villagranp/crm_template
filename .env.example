# =============================================================================
# APP
# =============================================================================
NODE_ENV=development
APP_NAME=enterprise-app
API_PORT=3000
API_GLOBAL_PREFIX=api
API_DEFAULT_VERSION=1
SWAGGER_ENABLED=true

# =============================================================================
# DATABASE (PostgreSQL por defecto; MariaDB/MySQL vía adaptador Prisma)
# =============================================================================
DATABASE_PROVIDER=postgresql
# Una base y un usuario POR APLICACION dentro de la instancia compartida del
# entorno (ver docs/deployment/environments.md). Sustituye `app` por el nombre
# del proyecto en snake_case: mi_cliente_ag, portal_proveedores...
# El puerto es 5433 a proposito: no ocupa el 5432, que suele estar tomado por un
# PostgreSQL instalado en la maquina.
DATABASE_URL=postgresql://app:app@localhost:5433/app?schema=public
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# Puerto del host de la instancia compartida (infrastructure/dev-infra).
POSTGRES_PORT=5433
# Prefijo de contenedores y redes de este proyecto. Por defecto, el nombre de
# la carpeta; ponlo si varios proyectos comparten nombre de directorio.
# COMPOSE_PROJECT_NAME=mi-cliente-ag
DATABASE_POOL_SIZE=10

# =============================================================================
# AUTH
# AUTH_PROVIDER: local | entra | hybrid
# =============================================================================
AUTH_PROVIDER=local
JWT_ISSUER=enterprise-app
JWT_AUDIENCE=enterprise-api
JWT_ACCESS_TOKEN_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_SECRET=
JWT_REFRESH_TOKEN_TTL=8h
# Contrasena inicial para altas y restablecimientos por administrador (12+
# caracteres). Obliga a cambiarla en el primer acceso. NUNCA un valor real aqui.
AUTH_DEFAULT_PASSWORD=

# =============================================================================
# MICROSOFT ENTRA ID (solo si AUTH_PROVIDER=entra|hybrid)
# Nunca colocar client secrets ni certificados en este archivo ni en Git.
# =============================================================================
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=
ENTRA_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
ENTRA_JWKS_URI=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys

# =============================================================================
# SEMILLA (solo para `prisma:seed`; no se usa en tiempo de ejecucion)
# =============================================================================
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_FIRST_NAME=Administrador
SEED_ADMIN_LAST_NAME=del sistema
# Contrasena inicial del administrador. Solo se aplica si aun no tiene
# credencial; nunca sobrescribe una existente. Obliga a cambiarla al entrar.
SEED_ADMIN_PASSWORD=

# =============================================================================
# CORS
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# =============================================================================
# LOGGING / OBSERVABILITY
# LOG_LEVEL: fatal | error | warn | info | debug | trace
# =============================================================================
LOG_LEVEL=info
LOG_PRETTY=true
CORRELATION_ID_HEADER=x-correlation-id

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# =============================================================================
# SNOWFLAKE (opcional; solo si el proyecto usa fuente analítica)
# =============================================================================
SNOWFLAKE_ENABLED=false
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
SNOWFLAKE_PRIVATE_KEY_PATH=

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
EXTERNAL_API_BASE_URL=
EXTERNAL_API_TIMEOUT_MS=10000

# =============================================================================
# FRONTEND (VITE_*: todo esto queda expuesto en el bundle; solo valores publicos)
# =============================================================================
# Ruta relativa: el SPA y la API comparten origen (proxy de Vite en desarrollo,
# NGINX en el resto). Una URL absoluta a otro origen rompe la sesion: el
# navegador no envia la cookie de refresco entre origenes.
VITE_API_BASE_URL=/api/v1
VITE_AUTH_PROVIDER=local
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_AUTHORITY=
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
VITE_ENTRA_API_SCOPE=
