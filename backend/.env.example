# Copia de las variables del backend. La fuente de verdad es el .env.example de la raiz.
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public
AUTH_PROVIDER=local
JWT_ISSUER=enterprise-app
JWT_AUDIENCE=enterprise-api
JWT_ACCESS_TOKEN_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# =============================================================================
# SEMILLA (solo para `pnpm run prisma:seed`)
# =============================================================================
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_FIRST_NAME=Administrador
SEED_ADMIN_LAST_NAME=del sistema
