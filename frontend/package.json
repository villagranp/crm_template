    "@mui/material": "^6.1.6",
    "@mui/x-charts": "8.29.3",
    "@tanstack/react-query": "^5.59.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
