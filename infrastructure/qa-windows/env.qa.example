# =============================================================================
# Configuración del backend en QA (Windows Server, ADR-026).
#
# Se copia a C:\apps\mi-cliente-ag\backend\.env y se rellenan los <...> EN EL
# SERVIDOR. Ahí lo leen el backend, la semilla y el CLI de Prisma (prisma
# migrate deploy solo busca el .env en backend\, no en la raíz). Ese .env no se
# versiona y solo lo leen los administradores y la cuenta del servicio. Ningún
# valor real en este archivo.
# Runbook: docs/deployment/qa-windows.md
# =============================================================================

NODE_ENV=production
APP_NAME=mi-cliente-ag
API_PORT=3000

# Usuario de la aplicación (dueño de su base, nunca postgres). connection_limit
# acota el pool frente a max_connections del servidor.
DATABASE_URL=postgresql://mi_cliente_ag_qa:<contraseña-del-usuario>@localhost:5432/mi_cliente_ag?schema=public&connection_limit=10

# Autenticación local (ADR-019). El corte a Entra ID (ADR-007, ADR-027) es DIRECTO: no hay modo
# híbrido. Para pasar a Entra: vincula a los usuarios por oid (load:data entra-identities), cambia
# a AUTH_PROVIDER=entra, rellena el bloque ENTRA_* de abajo y revoca las credenciales locales
# (auth:revoke-local). Runbook: AUTHENTICATION.md §4.3 y docs/deployment/qa-windows.md §14.
AUTH_PROVIDER=local
# Solo con AUTH_PROVIDER=entra (los valores los entrega el administrador del tenant; nunca se versionan):
# ENTRA_TENANT_ID=<tenant-id>
# ENTRA_CLIENT_ID=<application-id-de-la-API>
# ENTRA_AUDIENCE=<application-id-de-la-API>   # igual que el anterior si los tokens son v2
# ENTRA_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
# ENTRA_JWKS_URI=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# Obligatorios con AUTH_PROVIDER=entra y NODE_ENV=production (ADR-027; la API arranca solo con ambos):
# ENTRA_REQUIRED_SCOPE=access_as_user                  # scope delegado que expone la API (el token trae scp)
# ENTRA_ALLOWED_CLIENT_IDS=<application-id-de-la-SPA>  # azp permitido (lista separada por comas)
# La API debe emitir tokens v2 (accessTokenAcceptedVersion = 2 en su manifiesto) y la aplicación
# empresarial exigir «Asignación de usuarios requerida». Dominios del alta: parámetro seguridad.sso_dominios_permitidos.
JWT_ISSUER=mi-cliente-ag-qa
JWT_AUDIENCE=mi-cliente-ag-api
# 48 bytes aleatorios:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_TOKEN_SECRET=<secreto-aleatorio>
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=8h
# Contraseña inicial (12+) de los usuarios que da de alta o restablece un
# administrador; siempre con cambio obligatorio al entrar.
AUTH_DEFAULT_PASSWORD=<contraseña-inicial>

# Origen del navegador: https://<IP-del-servidor> (o el dominio de QA cuando exista).
CORS_ALLOWED_ORIGINS=https://<IP-del-servidor>

SWAGGER_ENABLED=false
LOG_LEVEL=info
LOG_PRETTY=false
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# Adjuntos (ADR-021): fuera del clon, para que una actualización no los toque,
# y respaldados junto con la base.
ATTACHMENTS_STORAGE_PATH=C:\data\mi-cliente-ag\attachments
