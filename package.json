{
  "name": "mi-cliente-ag",
  "version": "0.2.0",
  "private": true,
  "description": "CRM Mi Cliente AG",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./frontend\" --filter \"./backend\" dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -r test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,yml,yaml}\"",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "audit:security": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
